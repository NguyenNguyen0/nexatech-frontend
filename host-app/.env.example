# Auth micro-app (Next dev server) — dùng trong next.config rewrites
AUTH_URL="http://localhost:3001"

# API Gateway cho rewrite /api/v1/* (server-side). Không có trailing slash.
# Bắt buộc nếu không dùng NEXT_PUBLIC_BACKEND_BASE_URL.
API_GATEWAY_URL=http://localhost:8080

# Tuỳ chọn: gọi thẳng gateway từ trình duyệt (bỏ qua rewrite). Cùng lúc có thể bỏ API_GATEWAY_URL nếu chỉ dùng URL này.
# NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:8080
