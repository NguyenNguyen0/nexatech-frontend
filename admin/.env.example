VITE_BACKEND_BASE_URL=http://localhost:8080
VITE_GRAFANA_URL=http://localhost:3005
VITE_PROMETHEUS_URL=http://localhost:9090

# Internal registration — omitted/false = hidden (safe default).
# Dev only: uncomment or use .env.development (sets true for npm run dev).
VITE_ENABLE_INTERNAL_REGISTER=true
# Optional: set only if you have a real CopilotKit runtime endpoint.
# Leave empty to disable CopilotKit runtime auto-fetch in Agent page.
VITE_COPILOTKIT_RUNTIME_URL=
VITE_USE_AGUI=true
