# ============================================================
# PUBLIC ENVIROMENT
# ============================================================
# API Gateway base URL (no trailing slash). Auth routes: /api/v1/auth/*
# Example: http://localhost:8080
NEXT_PUBLIC_BACKEND_BASE_URL=

# Trang chủ host sau login (bắt buộc nếu chỉ mở auth tại :3001). Ví dụ: http://localhost:3000
# Khi đăng nhập qua host rewrite (:3000/auth/...) có thể để trống — dùng window.location.origin.
NEXT_PUBLIC_HOST_APP_ORIGIN=

# ============================================================
# INTERNAL ENVIROMENT
# (Không dùng nextauth không cần điền ở dưới => gắn token vào local cho nhanh)
# ============================================================
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# NEXTAUTH_URL
# NEXTAUTH_SECRET=
# REVALIDATE_SECRET=

# #SETUP thời gian hết hạn để refresh token
# TOKEN_EXPIRE_NUMBER=30
# TOKEN_EXPIRE_UNIT=seconds