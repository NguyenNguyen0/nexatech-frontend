{
  "name": "nexatech-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "NexaTech Micro-frontends Monorepo",
  "author": "NexaTech Team",
  "license": "ISC",
  "workspaces": [
    "auth",
    "cart",
    "host-app",
    "marketing",
    "nexatech-accountant",
    "nexatech-admin",
    "nexatech-manager",
    "nexatech-staff",
    "nexatech-warehouse",
    "order",
    "product",
    "user"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "npm run dev -ws --if-present",
    "dev:all": "concurrently --kill-others \"npm:w:dev:*\"",
    "build": "npm run build -ws --if-present",
    "build:all": "npm run build -ws --if-present",
    "start": "npm run start -ws --if-present",
    "lint": "npm run lint -ws --if-present",
    "preview": "npm run preview -ws --if-present",
    "type-check": "npm run type-check -ws --if-present",
    "clean": "npm run clean -ws --if-present",
    "w:dev:host": "npm run dev -w host-app",
    "w:dev:auth": "npm run dev -w auth",
    "w:dev:cart": "npm run dev -w cart",
    "w:dev:product": "npm run dev -w product",
    "w:dev:order": "npm run dev -w order",
    "w:dev:user": "npm run dev -w user",
    "w:dev:marketing": "npm run dev -w marketing",
    "w:dev:internal": "npm run dev -w internal",
    "w:build:host": "npm run build -w host-app",
    "w:build:auth": "npm run build -w auth",
    "w:build:internal": "npm run build -w internal"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "concurrently": "^9.1.2"
  }
}
