# Gateway gốc
NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:8080

# URL gốc của Next (dev)
AUTH_URL=http://localhost:3000
# Auth.js — tạo secret: npx auth secret
AUTH_SECRET=
# NextAuth Google OAuth (Console → redirect URI: {AUTH_URL}/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# API Gateway URL — proxied via next.config rewrites
API_GATEWAY_URL=http://localhost:3000

# Public frontend URL (used for metadata/SEO)
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000