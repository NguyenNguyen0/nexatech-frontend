# Gateway gốc (không có / cuối). Client + server Auth dùng chung; identity: `${NEXT_PUBLIC_BACKEND_BASE_URL}/api/v1/auth/...`
NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:8080

# Auth.js — tạo secret: npx auth secret
AUTH_SECRET=

# URL gốc của Next (dev)
AUTH_URL=http://localhost:3000

# API Gateway URL — proxied via next.config rewrites
API_GATEWAY_URL=http://localhost:3000

# Public frontend URL (used for metadata/SEO)
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# ─── Feature Flags ──────────────────────────────────────────
# USE_MOCK_API: Toggle between mock API and real product service
#   - true: Use local mock API routes (Next.js /api/v1/[...path]/route.ts)
#   - false: Use real API Gateway (default)
NEXT_PUBLIC_FEATURE_FLAG_USE_MOCK_API=false
